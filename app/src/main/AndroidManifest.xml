<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Salah's permissions, each with the exact feature that needs it. Nothing is declared "just in
      case", and no permission is requested at startup: every one is either granted at install time
      or asked for from the prayer-notification settings screen, when the user takes the action that
      requires it. See docs/PRAYER_NOTIFICATIONS.md §3.

        POST_NOTIFICATIONS    API 33+ runtime permission. Without it the platform accepts a posted
                              notification but never shows it. Asked for from the notifications
                              screen when the user enables reminders.

        RECEIVE_BOOT_COMPLETED
                              Alarms do not survive a reboot. Without this the schedule would be
                              silently lost until the user next opened the app.

        SCHEDULE_EXACT_ALARM   API 31+ special permission. Without it setExactAndAllowWhileIdle
                              throws, so Salah falls back to a windowed alarm and tells the user
                              that reminders may be a few minutes late. Asked for separately from
                              notification permission, because they are different permissions with
                              different capabilities.

        VIBRATE               Required for notification vibration. Salah offers a per-prayer
                              vibration preference, so the permission is used.

        ACCESS_COARSE_LOCATION
        ACCESS_FINE_LOCATION  The Qibla screen can ask the device for a position instead of
                              making the user type coordinates. Both are declared so that the
                              Android 12+ runtime dialog can offer "Approximate" and "Precise"
                              and the user keeps that choice; Salah works with either, and
                              manual coordinates work with neither. Asked for only when the
                              user taps the relevant button — see docs/QIBLA_COMPASS.md
                              section 4.

      Deliberately NOT requested:
        * no INTERNET — every feature runs offline. The location picker works from the bundled
          dataset, prayer times are calculated on-device, and nothing in the app opens a network
          connection;
        * no ACCESS_BACKGROUND_LOCATION — the Qibla screen needs a position only while it is in
          front of the user, and a background grant would be a permission without a purpose;
        * no FOREGROUND_SERVICE permission — no long-running service exists (see section 5 of the
          notifications doc, which explains why long-form background Azan playback is not
          implemented).
    -->

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!--
      Hardware is declared optional, not required.

      Salah's Qibla screen is designed to be honest about what a device can do: without a
      magnetometer it still shows the exact bearing and says why the dial cannot turn, and without a
      location provider the user can enter coordinates by hand. Marking these required would remove
      the app from those devices entirely, which is the opposite of the intent.
    -->
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-feature android:name="android.hardware.location.network" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.compass" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.accelerometer" android:required="false" />

    <application
        android:name=".SalahApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Salah">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Salah"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          The alarm that fires when a reminder is due.

          Not exported: it is reached only by Salah's own PendingIntents, which name this class
          explicitly. The alarm Intent therefore has no implicit action another app could resolve,
          so nothing outside Salah can trigger a prayer notification.
        -->
        <receiver
            android:name=".data.notification.PrayerNotificationReceiver"
            android:enabled="true"
            android:exported="false" />

        <!--
          Reboot, clock, time-zone, date and app-update recovery.

          Exported because these are broadcasts the *system* delivers to manifest receivers, and
          every action listed is a protected broadcast that only the system may send — so exporting
          it does not let another app drive a reconciliation. The work performed is idempotent
          either way: a reconciliation repeated is a reconciliation with the same result.

          Alarms do not survive a reboot, which is exactly why this receiver exists.
        -->
        <receiver
            android:name=".data.notification.SystemEventReconciliationReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.DATE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
