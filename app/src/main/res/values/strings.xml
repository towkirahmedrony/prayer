    <string name="feature_calendar_title">Calendar</string>
    <string name="feature_calendar_body">Gregorian, Bangladesh Bangla and Hijri conversion with confirmed-date overrides is planned. Only the Gregorian date from the device clock is implemented today.</string>
    <string name="feature_ramadan_title">Ramadan</string>
