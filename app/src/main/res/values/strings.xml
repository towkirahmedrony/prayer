    <string name="settings_engine_title">Prayer engine</string>
    <string name="settings_engine_body">Local astronomical calculation (Adhan Kotlin), computed on this device. It needs no internet connection, no account and no permission.</string>
    <string name="settings_calculation_title">Calculation settings</string>
    <string name="settings_calculation_body">Every time Salah shows is calculated on this device from your coordinates, the date and the settings below. Changing any option recalculates the timetable.</string>
    <string name="settings_method_title">Calculation method</string>
    <string name="settings_method_body">The method sets the twilight angles used for Fajr and Isha. Changing it changes those times, and can shift Dhuhr and Maghrib slightly as well. These are calculation conventions, not a claim to reproduce any authority\'s published timetable.</string>
    <string name="settings_asr_title">Asr calculation</string>
    <string name="settings_asr_body">Affects the Asr time only. Hanafi Asr is always later than standard Asr.</string>
    <string name="settings_high_latitude_title">High-latitude rule</string>
    <string name="settings_high_latitude_body">Only matters where Fajr or Isha can fall outside the night. At Bangladesh\'s latitude it does not change the calculated times.</string>
    <string name="settings_time_format_title">Time format</string>
    <string name="settings_adjustments_title">Manual adjustments</string>
    <string name="settings_adjustments_body">Optional corrections in minutes, added to the calculated time. Use them to match a local timetable you trust; leave them at 0 to show exactly what the engine calculates.</string>
    <string name="settings_adjustments_clear">Reset all to 0</string>
    <string name="settings_adjustment_decrease">One minute earlier</string>
    <string name="settings_adjustment_increase">One minute later</string>
    <string name="settings_adjustment_minutes">%1$s min</string>
    <string name="settings_calculation_saved">Saved. Prayer times have been recalculated.</string>
    <string name="settings_about_title">About Salah</string>
    <string name="settings_about_body">Salah is an offline-first Islamic companion. Gregorian dates come from the device clock, and prayer times are calculated locally by an astronomical engine. Bangla and Hijri conversion, prohibited-time rules and notifications are not implemented yet.</string>
