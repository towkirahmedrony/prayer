<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon background layer, converted 1:1 from docs/artwork/salah_icon_background.svg
  (deep-green radial gradient, authored at 1024x1024). Full-bleed: the launcher masks the shape.

  Referenced by res/mipmap-anydpi-v26/ic_launcher.xml and ic_launcher_round.xml.
  A vector keeps the gradient crisp at every density, so no PNG per density is needed.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="1024"
    android:viewportHeight="1024">

    <path android:pathData="M0,0h1024v1024h-1024z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="512"
                android:centerY="143.36"
                android:gradientRadius="880.64">
                <item android:offset="0.0" android:color="#FF09523E" />
                <item android:offset="0.22" android:color="#FF074736" />
                <item android:offset="0.52" android:color="#FF053428" />
                <item android:offset="0.80" android:color="#FF04251E" />
                <item android:offset="1.0" android:color="#FF031C15" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
