<?xml version="1.0" encoding="utf-8"?>
<!--
  Data extraction rules for Android 12+ (API 31 and above): both cloud backup and device-to-device
  transfer. API 30 and below use backup_rules.xml, which must stay in step with this file.

  The reasoning is written out once, in backup_rules.xml; the short version is that
  `androidx.datastore.preferences` keeps Salah's preferences and the saved location in
  `<filesDir>/datastore/`, so `file/datastore/` is the path that actually has to be included, and
  `sharedpref` is kept because it costs nothing. Applied dataset payloads under `file/datasets/` are
  deliberately excluded: they are replaceable, and the bundled assets always reconstruct a usable
  dataset.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="datastore/" />
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore/" />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
