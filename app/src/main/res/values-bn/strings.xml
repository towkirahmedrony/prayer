    <string name="calendar_ramadan_upcoming">এই ডিভাইসের হিসাব অনুযায়ী, পরবর্তী রমজান প্রায় দুই মাসের মধ্যে আশা করা হচ্ছে।</string>
    <string name="calendar_ramadan_not_near">এই ডিভাইসের হিসাব অনুযায়ী, রমজান এখন থেকে প্রায় দুই মাসেরও বেশি দূরে।</string>
    <string name="calendar_ramadan_estimate_note">এই সময়কাল উম্মুল কুরার হিসাব থেকে পাওয়া, বাংলাদেশের ধর্মীয় কর্তৃপক্ষের ঘোষণা থেকে নয়; তাই স্থানীয় চাঁদ দেখার ভিত্তিতে শুরু ও শেষ এক দিন সরে যেতে পারে।</string>
    <string name="calendar_occasion_note">পালনীয় দিনগুলো হিজরি ক্যালেন্ডার অনুসরণ করে, তাই স্থানীয় চাঁদ দেখার ভিত্তিতে সেগুলো এক দিন সরে যেতে পারে।</string>

    <string name="calendar_settings_body">এই ডিভাইসে সংরক্ষিত। এই পছন্দগুলো প্রতিটি ক্যালেন্ডার স্ক্রিনে যা দেখানো হয় তা পরিবর্তন করে।</string>
    <string name="calendar_default_view_body">ক্যালেন্ডার স্ক্রিন কোন ক্যালেন্ডারে খুলবে। মাসের গ্রিড, তার মাস ও বারগুলোর নাম, দিনের সংখ্যা এবং বছর—সবই নির্বাচিত ক্যালেন্ডার অনুসরণ করে; নির্বাচিত দিনের জন্য অন্য ক্যালেন্ডারগুলোও দেখানো হয়।</string>
    <string name="calendar_hijri_adjustment_body">সালাহর হিজরি তারিখ উম্মুল কুরার একটি অনুমান। আপনার সমাজ ভিন্ন তারিখ অনুসরণ করলে এখানে তা সমন্বয় করুন: প্রতিটি হিজরি তারিখ, আনুমানিক রমজান সময়কাল এবং রমজানের রিমাইন্ডার এর সাথে সরে যাবে। ফলাফলটি এখনও অনুমান হিসেবেই জানানো হয়, কারণ তা অনুমানই।</string>
    <string name="calendar_hijri_adjustment_value">সমন্বয়: %1$s দিন</string>
    <string name="calendar_hijri_adjustment_range">−%1$d থেকে +%1$d দিনের মধ্যে</string>
    <string name="calendar_language_body">ক্যালেন্ডারের তারিখ কোন লিপি ও সংখ্যায় লেখা হবে। এটি ইন্টারফেসের ভাষা থেকে আলাদা।</string>
    <string name="calendar_sources_title">এই তারিখগুলো কোথা থেকে আসে</string>
    <string name="calendar_sources_body">গ্রেগরিয়ান তারিখ আসে ডিভাইসের ঘড়ি থেকে। বঙ্গাব্দ ২০১৯ সালে সংশোধিত বাংলাদেশের সরকারি নিয়মে রূপান্তর করা হয়, এবং যে বছরগুলোর জন্য নিয়মগুলো যাচাই করা হয়েছে শুধু সেগুলোর জন্যই তা দেখানো হয়। হিজরি তারিখ অ্যান্ড্রয়েডে অন্তর্ভুক্ত উম্মুল কুরা সারণি থেকে অনুমান করা হয় এবং সর্বদা অনুমান হিসেবেই চিহ্নিত থাকে। এর কোনোটির জন্যই ইন্টারনেট সংযোগ লাগে না।</string>
    <string name="calendar_reminders_note">সেহরি ও ইফতারের রিমাইন্ডার অন্য নামাজের রিমাইন্ডারগুলোর সাথেই কনফিগার করা হয়, তাই তারা একই শিডিউলার, একই অনুমতি এবং একই চ্যানেল ভাগ করে নেয়।</string>
    <string name="calendar_source_computed">এই ডিভাইসে হিসাব করা</string>

